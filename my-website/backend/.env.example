# Local API development
NODE_ENV=development
PORT=3000

# Production article publishing
# Absolute filesystem path of the frontend document root served at
# https://helveclick.ch. It is normally the frontend build output (`dist`),
# and must be persistent and writable by the API process.
# SITE_PUBLIC_ROOT=/absolute/path/to/frontend/dist

# Optional when the directory served by Express differs from SITE_PUBLIC_ROOT.
# SITE_DISTRIBUTION_ROOT=/absolute/path/to/frontend/dist
